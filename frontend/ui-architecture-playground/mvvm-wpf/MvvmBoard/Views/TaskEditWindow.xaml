<Window x:Class="MvvmBoard.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" FontSize="14" Background="#F7F9FC">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#5B667A"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Кнопки: IsEnabled биндится на CanSave VM - валидация без единой
             строчки кода в code-behind. Кнопка «Сохранить» серая, пока
             заголовок пуст или дата неверна. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="14,5"
                    IsCancel="True"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Command="{Binding SaveCommand}" Padding="14,5"
                    Margin="10,0,0,0" IsDefault="True"
                    Background="#7B61FF" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Ошибка валидации - обычное bindable-свойство Error -->
        <Border DockPanel.Dock="Bottom" Background="#FDE3E1" CornerRadius="4" Padding="8,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="#C0392B"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Заголовок *" Style="{StaticResource Lbl}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"/>

                <TextBlock Text="Описание" Style="{StaticResource Lbl}"/>
                <TextBox Text="{Binding Description}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="90" Padding="8,6"
                         VerticalScrollBarVisibility="Auto"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Статус" Style="{StaticResource Lbl}"/>
                        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип" Style="{StaticResource Lbl}"/>
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Приоритет" Style="{StaticResource Lbl}"/>
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дедлайн (дд.ММ.гггг)" Style="{StaticResource Lbl}"/>
                        <TextBox Text="{Binding DeadlineText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Исполнитель" Style="{StaticResource Lbl}"/>
                <ComboBox ItemsSource="{Binding Assignees}"
                          SelectedValue="{Binding AssigneeId}"
                          SelectedValuePath="Id" DisplayMemberPath="Label"/>

                <TextBlock Text="Эпик" Style="{StaticResource Lbl}"/>
                <ComboBox ItemsSource="{Binding Epics}"
                          SelectedValue="{Binding EpicId}"
                          SelectedValuePath="Id" DisplayMemberPath="Label"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
