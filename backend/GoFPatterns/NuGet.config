<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Убрать источник nuget.org, когда будем дублировать все необходимые Nuget-пакеты в наше хранилище -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
  </packageSources>

  <!-- Определяем сопоставления шаблонов названий пакетов и источников-->
  <packageSourceMapping>
      <packageSource key="nuget.org">
        <package pattern="*"/>
      </packageSource>
    </packageSourceMapping>
</configuration>
